#usda 1.0
(
    defaultPrim = "Fern"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Fern"
{
    def Scope "Materials"
    {
        def Material "Mat_Fern"
        {
            token outputs:surface.connect = </Fern/Materials/Mat_Fern/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.5, 0.2)
                float inputs:metallic = 0
                float inputs:roughness = 0.75
                token outputs:surface
            }
        }
    }

    def Xform "Frond_0"
