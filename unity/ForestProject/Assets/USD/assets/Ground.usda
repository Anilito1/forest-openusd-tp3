#usda 1.0
(
    defaultPrim = "Ground"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Ground"
{
    def Scope "Materials"
    {
        def Material "Mat_Ground"
        {
            token outputs:surface.connect = </Ground/Materials/Mat_Ground/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.34, 0.28, 0.18)
                float inputs:metallic = 0
                float inputs:roughness = 0.95
                token outputs:surface
            }
        }
    }

    def Mesh "Surface"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        rel material:binding = </Ground/Materials/Mat_Ground>
        point3f[] points = [(-20, 0, -20), (20, 0, -20), (20, 0, 20), (-20, 0, 20)]
        uniform token subdivisionScheme = "none"
    }
}

